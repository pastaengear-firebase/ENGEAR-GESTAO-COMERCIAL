rules_version = '2';

service firebase.storage {
  match /b/{bucket}/o {

    // Sales uploads: any authenticated user can read;
    // write is allowed for authenticated users.
    // TODO: add full ownership validation via Firestore cross-reads (future improvement).
    match /sales/{allPaths=**} {
      allow read: if request.auth != null;
      allow write: if request.auth != null;
    }

    // Default: deny everything else
    match /{allPaths=**} {
      allow read, write: if false;
    }
  }
}
